{
  "project": {
    "name": "Sharon's Cookbook",
    "summary": "The myCookbook phone app (offline-first recipes, planner, pantry, shopping, garden) and the workspace that adds recipes to it, updates it, and releases it.",
    "repo": "tancookjr-ops/sharons-cookbook",
    "language_rule": "Canadian spelling",
    "content_rules": [
      "Every recipe is vegan \u2014 no meat, fish, animal dairy, eggs or honey."
    ],
    "brand_rules": []
  },
  "environment": {
    "device": "an iPad (Safari) and Sharon's phone",
    "session": "Claude Code on the web (cloud)"
  },
  "branches": {
    "staging": "Develop",
    "production": "Production",
    "work_prefix": "claude/"
  },
  "hosting": {
    "pages_switched": true,
    "ftp": "later"
  },
  "site": {
    "app_paths": [
      "index.html",
      "manifest.webmanifest",
      "*.css",
      "*.js",
      "*.jsx",
      "tokens",
      "icons",
      "images",
      "recipes/*.js"
    ],
    "extra_paths": [
      "design-system/styles.css",
      "design-system/base.css",
      "design-system/components.css",
      "design-system/patterns.css",
      "design-system/tokens",
      "design-system/assets",
      "design-system/ui_kits"
    ],
    "sandbox_replace": [
      "mycookbook-=cbstaging-",
      "sharons-cookbook-=cbstaging-legacy-"
    ],
    "sandbox_globs": [
      "*.js",
      "*.jsx"
    ],
    "sandbox_guard_file": "auth.js",
    "sw_file": "sw.js",
    "manifest_file": "manifest.webmanifest",
    "staging_label": "STAGING",
    "data_description": "The app keeps everything on the phone (localStorage); there is no server copy."
  },
  "mirrors": [
    [
      "styles.css",
      "design-system"
    ],
    [
      "base.css",
      "design-system"
    ],
    [
      "components.css",
      "design-system"
    ],
    [
      "patterns.css",
      "design-system"
    ],
    [
      "tokens/*.css",
      "design-system"
    ],
    [
      "manifest.webmanifest",
      "design-system/deploy"
    ],
    [
      "sw.js",
      "design-system/deploy"
    ],
    [
      "styles.css",
      "design-system/deploy"
    ],
    [
      "base.css",
      "design-system/deploy"
    ],
    [
      "components.css",
      "design-system/deploy"
    ],
    [
      "patterns.css",
      "design-system/deploy"
    ],
    [
      "tokens/*.css",
      "design-system/deploy"
    ],
    [
      "app.jsx",
      "design-system/deploy"
    ],
    [
      "auth.js",
      "design-system/deploy"
    ],
    [
      "data.js",
      "design-system/deploy"
    ],
    [
      "import-parse.js",
      "design-system/deploy"
    ],
    [
      "import-web.js",
      "design-system/deploy"
    ],
    [
      "screens-main.jsx",
      "design-system/deploy"
    ],
    [
      "screens-more.jsx",
      "design-system/deploy"
    ],
    [
      "units.js",
      "design-system/deploy"
    ],
    [
      "recipes/*.js",
      "design-system/deploy"
    ],
    [
      "icons/*.png",
      "design-system/deploy"
    ],
    [
      "app.jsx",
      "design-system/ui_kits/cookbook"
    ],
    [
      "auth.js",
      "design-system/ui_kits/cookbook"
    ],
    [
      "data.js",
      "design-system/ui_kits/cookbook"
    ],
    [
      "import-parse.js",
      "design-system/ui_kits/cookbook"
    ],
    [
      "import-web.js",
      "design-system/ui_kits/cookbook"
    ],
    [
      "screens-main.jsx",
      "design-system/ui_kits/cookbook"
    ],
    [
      "screens-more.jsx",
      "design-system/ui_kits/cookbook"
    ],
    [
      "units.js",
      "design-system/ui_kits/cookbook"
    ],
    [
      "recipes/*.js",
      "design-system/ui_kits/cookbook"
    ]
  ],
  "kept": [
    {
      "path": "design-system/deploy/",
      "why": "the design tool's deploy package; kept identical by `scripts/sync-mirrors.sh`"
    },
    {
      "path": "design-system/ui_kits/cookbook/",
      "why": "offline standalone version of the app, published with production"
    }
  ],
  "archive": [
    {
      "was": "`design-system/upload-v1.2.*`",
      "status": "removed: partial snapshots, genuine duplicates",
      "where": "the backup zip (release `design-system-backup`); git history"
    }
  ],
  "jobs": [
    {
      "slug": "recipes",
      "name": "Add a recipe",
      "stages": [
        {
          "slug": "01_draft",
          "job": "turn a raw recipe into a checked draft",
          "input": "`inbox/<anything>` \u2014 pasted text, a link, a photo",
          "check": "the owner reads the draft against the recipe structure \u2014 amounts, units, steps, tags, vegan"
        },
        {
          "slug": "02_add",
          "job": "put approved drafts into the app's recipe files",
          "check": ""
        }
      ]
    }
  ],
  "where_extra": [
    {
      "path": "root app files (`index.html`, `*.jsx`, `*.js`, `*.css`, `tokens/`, `icons/`, `sw.js`)",
      "what": "the live app \u2014 **the one source of truth**; paths must not move"
    },
    {
      "path": "`recipes/`",
      "what": "the built-in recipe collection"
    },
    {
      "path": "`design-system/`",
      "what": "design tools + mirrored copies \u2014 own `CLAUDE.md`"
    }
  ],
  "guarded_extra": [
    "`sw.js` `VERSION` and cache names \u2014 they control every installed phone"
  ],
  "dependabot_npm_dirs": [
    "/design-system/tools"
  ],
  "design_backup": {
    "source": "https://github.com/tancookjr-ops/sharons-cookbook/releases/download/design-system-backup/Sharon.s.Cookbook.Design.System.zip"
  },
  "automation": {
    "auto_merge": true,
    "merge_method": "merge",
    "max_fix_rounds": 3,
    "watch_deploy": true,
    "install_icm_architect": true
  }
}